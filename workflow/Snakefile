import os

configfile: "smk-config-h100.yaml"

ROOT = os.path.abspath(os.path.join(workflow.basedir, ".."))
os.environ["PYTHONPATH"] = os.pathsep.join(filter(None, [ROOT, os.environ.get("PYTHONPATH")]))

include: "rules/cpu.smk"
include: "rules/gpu.smk"

