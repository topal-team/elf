	model=r"[a-zA-Z0-9_-]+",
	sequence_length=r"\d+",
	ngpus=r"\d+",
	nstages=r"\d+",
	gpu_type=r"[a-zA-Z0-9]+",
	mem=r"\d+",
	method=r"[a-zA-Z0-9_-]+"
